@page "/counter"
@rendermode InteractiveAuto
<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<ErrorBoundary @ref="_errorBoundary">
    <ChildContent>
        <div class="counter-block">
            <div class="counter-content">
                <div class="counter-count">
                    @currentCount
                </div>
                <div class="counter-text">
                    current count
                </div>
                <div class="counter-block-back"></div>
            </div>
            <DxButton Click="IncrementCount">Click me</DxButton>
            <DxButton Click="DivideByZero">Divide by Zero</DxButton>
        </div>
    </ChildContent>
    <ErrorContent>
        <p>@context.Message Clear the error.</p>
        <DxButton Context="another_context" click="Recover">Clear</DxButton>
        <br/>
    </ErrorContent>
</ErrorBoundary>


@code {
    ErrorBoundary _errorBoundary;

    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }

    private void DivideByZero()
    {
        var zero = 0;
        var i = 10 / zero;
    }

    private void Recover()
    {
        _errorBoundary?.Recover();
    }
}